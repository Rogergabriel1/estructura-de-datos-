#include <iostream>
using namespace std;

class Lista {
private:
    struct Nodo {
        int dato;
        Nodo* sig;
    };

    Nodo* cab;
    Nodo* fin;

    static Nodo* invertir(Nodo* p) {
        Nodo* prev = nullptr;

        while (p != nullptr) {
            Nodo* siguiente = p->sig;
            p->sig = prev;
            prev = p;
            p = siguiente;
        }

        return prev;
    }

public:
    Lista() : cab(nullptr), fin(nullptr) {
    }

    ~Lista() {
        while (cab != nullptr) {
            Nodo* borrar = cab;
            cab = cab->sig;
            delete borrar;
        }
    }

    Lista(const Lista&) = delete;
    Lista& operator=(const Lista&) = delete;

    void insertarFinal(int x) {
        Nodo* nuevo = new Nodo{x, nullptr};

        if (cab == nullptr) {
            cab = nuevo;
        } else {
            fin->sig = nuevo;
        }

        fin = nuevo;
    }

    // No es const: modifica enlaces temporalmente, pero deja la lista igual al salir
    bool esPalindromo() {
        if (cab == nullptr || cab->sig == nullptr) {
            return true;
        }

        Nodo* lento = cab;
        Nodo* rapido = cab;

        while (rapido->sig != nullptr && rapido->sig->sig != nullptr) {
            lento = lento->sig;
            rapido = rapido->sig->sig;
        }

        Nodo* segunda = invertir(lento->sig);
        lento->sig = nullptr;
        bool resultado = true;
        Nodo* p = cab;
        Nodo* q = segunda;

        while (q != nullptr) {
            if (p->dato != q->dato) {
                resultado = false;
            }

            p = p->sig;
            q = q->sig;
        }

        lento->sig = invertir(segunda);
        return resultado;
    }

    void mostrar() const {
        cout << "[ ";

        for (Nodo* p = cab; p != nullptr; p = p->sig) {
            cout << p->dato << " ";
        }

        cout << "]" << endl;
    }
};

int main() {
    Lista lista;
    int n;

    cout << "Cuantos datos tiene la lista? ";
    cin >> n;

    while (n < 0) {
        cout << "Debe ser 0 o mayor. Cuantos datos? ";
        cin >> n;
    }

    for (int i = 0; i < n; i++) {
        int x;
        cout << "Dato " << i + 1 << ": ";
        cin >> x;
        lista.insertarFinal(x);
    }

    cout << "Lista antes:   ";
    lista.mostrar();

    if (lista.esPalindromo()) {
        cout << "La lista ES palindroma" << endl;
    } else {
        cout << "La lista NO es palindroma" << endl;
    }

    cout << "Lista despues: ";
    lista.mostrar();
    return 0;
}
